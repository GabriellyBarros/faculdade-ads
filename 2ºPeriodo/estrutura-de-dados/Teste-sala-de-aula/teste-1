#include <stdio.h>

int main(void)
{
	int i=0, numero=1, soma=0;
	for(i=1; numero!=0; ++i)
	{
		printf("Infome o valor %d:", i);
		scanf("%d", &numero);
		soma += numero;
	
	}
		
	i-=2;
	printf("Media dos %d numeros: %.2f", i, (float) soma/i);
	return 0;
}
