        System.out.println("3. Consultar Desempenho");
        System.out.println("4. Sair");
        System.out.println("Digite uma opção: ");
        op = input.nextInt();
        input.nextLine();

        switch (op) {
            case 1:
                System.out.print("Digite o titulo do livro:");
